{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:data-modeling:modeling-review:1.0.0",
  "title": "Optional structured modeling review, separate from viewer data 1.0.0",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "complexity": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "simple",
            "standard",
            "complex"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "level",
        "reason"
      ],
      "additionalProperties": false
    },
    "alternatives": {
      "type": "object",
      "properties": {
        "not_needed_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "revisit_when": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "decision_id",
              "criteria",
              "revisit_when"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reviews"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "enum": [
              "identity",
              "ownership",
              "lifecycle",
              "time",
              "aggregation",
              "concurrency",
              "integration",
              "access",
              "retention"
            ]
          },
          "status": {
            "enum": [
              "addressed",
              "open",
              "excluded",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "review_points": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "topic",
          "status",
          "reason",
          "requirements",
          "scenarios",
          "review_points"
        ],
        "additionalProperties": false
      }
    },
    "change_impact": {
      "type": "object",
      "properties": {
        "baseline": {
          "enum": [
            "new",
            "existing",
            "unknown"
          ]
        },
        "baseline_note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "area": {
                "enum": [
                  "writes",
                  "reads",
                  "contracts",
                  "existing_data",
                  "history",
                  "rollout",
                  "rollback"
                ]
              },
              "status": {
                "enum": [
                  "affected",
                  "unaffected",
                  "unknown",
                  "not_applicable"
                ]
              },
              "note_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "review_points": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "area",
              "status",
              "note_ref",
              "entities",
              "review_points"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "baseline",
        "baseline_note",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "complexity",
    "alternatives",
    "rules",
    "change_impact"
  ],
  "additionalProperties": false
}
