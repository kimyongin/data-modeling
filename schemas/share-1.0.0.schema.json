            "compatibility"
          ]
        },
        "initial_entity": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "design_summary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "overview": {
          "$ref": "#/$defs/overview"
        },
        "process": {
          "$ref": "#/$defs/process"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "extensions": {
          "type": "object"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "minItems": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "minItems": 1
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "minItems": 0
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "minItems": 0
        },
        "review_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_point"
          },
          "minItems": 0
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "renderer_version",
        "review_profile",
        "title",
        "summary",
        "requirements",
        "entities",
        "relationships",
        "scenarios"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "review_profile": {
                "const": "standard"
              }
            },
            "required": [
              "review_profile"
            ]
          },
          "then": {
            "required": [
              "scope",
              "level",
              "overview",
              "process",
              "sources",
              "decisions",
              "review_points",
              "assumptions",
              "limitations"
            ],
            "properties": {
              "overview": {
                "required": [
                  "diagram"
                ]
              },
              "requirements": {
                "items": {
                  "required": [
                    "example"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "design"
                      ]
                    },
                    {
                      "required": [
                        "design_points"
                      ]
                    }
                  ]
                }
              },
              "entities": {
                "items": {
                  "required": [
                    "name",
                    "description",
                    "short_description",
                    "example",
                    "review_question",
                    "insights",
                    "rows",
                    "requirements",
                    "sources"
                  ],
                  "properties": {
                    "columns": {
                      "items": {
                        "required": [
                          "label",
                          "type",
                          "key",
                          "nullable",
                          "description"
                        ]
                      }
                    }
                  }
                }
              },
              "relationships": {
                "items": {
                  "required": [
                    "name",
                    "rationale",
                    "foreign_key",
                    "rule",
                    "enforcement",
                    "requirements",
                    "sources"
                  ]
                }
              },
              "sources": {
                "items": {
                  "required": [
                    "kind",
                    "checked_at",
                    "claim",
                    "limitation",
                    "reading_note"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "url"
                      ]
                    },
                    {
                      "required": [
                        "location"
                      ]
                    }
                  ]
                }
              },
              "scenarios": {
                "items": {
                  "required": [
                    "entities",
                    "explanation"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "executed_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "status",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "engine",
        "scope",
        "executed_at",
        "results"
      ],
      "additionalProperties": false
    },
    "build_metadata": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "renderer_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "review_profile": {
          "enum": [
            "standard",
            "compatibility"
          ]
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verification_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "renderer_release_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "renderer_version",
        "review_profile",
        "input_sha256",
        "verification_sha256",
        "renderer_release_sha256"
      ],
      "additionalProperties": false
    }
  }
}
